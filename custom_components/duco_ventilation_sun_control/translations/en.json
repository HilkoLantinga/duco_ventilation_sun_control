{
  "config": {
    "step": {
      "user": {
        "title": "Connect to Duco Ventilation Unit",
        "description": "Enter the hostname or IP address of your Duco unit.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]"
        }
      },
      "finish_v2_setup": {
        "title": "API Key Required (API V2)",
        "description": "The Duco unit at `{host}` uses API V2, which requires an API key for configuration changes and actions. Please enter the API key found in your Duco unit's settings.",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        }
      },
      "zeroconf_confirm": {
        "title": "Duco Unit Found",
        "description": "Found Duco unit `{name}` at `{host}` using API `{api_version}`. Do you want to add this device?"
      },
      "reauth_confirm": {
        "title": "Re-authenticate Duco Unit",
        "description": "Authentication failed for Duco unit at `{host}` (API V2). Please re-enter the API key.",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the Duco unit. Please check the hostname/IP address and network connection.",
      "invalid_auth": "Invalid API key. Please check the key and try again.",
      "unknown": "An unknown error occurred during setup.",
      "unknown_api_version": "Could not determine the API version from the discovered device.",
      "discovery_error": "An error occurred during discovery processing.",
      "device_not_ready": "Device is not ready. Please check connection and try again later.",
      "missing_unique_id": "Could not determine a unique ID (MAC or Serial) for the device. Cannot add device."
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "already_in_progress": "Configuration flow is already in progress.",
      "cannot_connect": "Failed to connect to the device.",
      "unknown_api_version": "Could not determine the API version.",
      "unknown": "An unknown error occurred.",
      "discovery_error": "Discovery processing error.",
      "device_not_ready": "Device not ready.",
      "missing_unique_id": "Could not determine a unique ID.",
      "context_error": "Configuration flow context error. Please start again.",
      "reauth_successful": "Re-authentication successful.",
      "reauth_not_required_v1": "Re-authentication is not required for V1 API devices."
    }
